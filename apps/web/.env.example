# The libSQL driver resolves relative paths from the folder you run Next in
# (apps/web), so this points at the database you created in apps/api.
# In production, use an absolute path or a hosted database URL.
DATABASE_URL="file:../api/dev.db"
# Required, 32+ random characters. Must match the one in apps/api/.env if you
# want sessions to work across both servers. Generate with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=
